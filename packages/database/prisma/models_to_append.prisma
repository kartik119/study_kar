enum RevisionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model RevisionCategory {
  id                     String                   @id @default(uuid())
  code                   String                   @unique
  nameEn                 String
  nameKn                 String
  descriptionEn          String?
  descriptionKn          String?
  iconUrl                String?
  displayOrder           Int                      @default(0)
  isActive               Boolean                  @default(true)
  createdByAdminId       String?
  updatedByAdminId       String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  cards                  RevisionCard[]
  subcategories          RevisionSubcategory[]

  @@map("revision_categories")
}

model RevisionSubcategory {
  id                  String              @id @default(uuid())
  categoryId          String
  code                String              @unique
  nameEn              String
  nameKn              String
  descriptionEn       String?
  descriptionKn       String?
  iconUrl             String?
  displayOrder        Int                 @default(0)
  isActive            Boolean             @default(true)
  createdByAdminId    String?
  updatedByAdminId    String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  cards               RevisionCard[]
  category            RevisionCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("revision_subcategories")
}

model RevisionCollection {
  id             String           @id @default(uuid())
  name           String
  description    String?
  isFreeSample   Boolean          @default(false)
  status         RevisionStatus   @default(DRAFT)
  examCycleId    String?
  subjectId      String?
  categoryId     String?
  subcategoryId  String?
  topicId        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  cards          RevisionCard[]

  @@map("revision_collections")
}

model RevisionCard {
  id                     String                  @id @default(uuid())
  collectionId           String?
  isFreeSample           Boolean                 @default(false)
  status                 RevisionStatus          @default(DRAFT)
  orderIndex             Int                     @default(0)
  examCycleId            String?
  subjectId              String?
  categoryId             String?
  subcategoryId          String?
  topicId                String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  contentEn              Json?
  contentKn              Json?
  metaDescriptionEn      String?
  metaDescriptionKn      String?
  metaTitleEn            String?
  metaTitleKn            String?
  priority               String                  @default("Medium")
  publishDate            DateTime?
  slug                   String                  @unique
  titleEn                String
  titleKn                String?
  imageEn                String?
  imageKn                String?
  category               RevisionCategory?       @relation(fields: [categoryId], references: [id])
  collection             RevisionCollection?     @relation(fields: [collectionId], references: [id])
  subcategory            RevisionSubcategory?    @relation(fields: [subcategoryId], references: [id])

  @@index([collectionId])
  @@index([status])
  @@map("revision_cards")
}
