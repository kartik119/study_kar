datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PreparationLanguage {
  en
  kn
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AccountType {
  STUDENT
  ADMIN
}

enum OtpPurpose {
  STUDENT_REGISTRATION
  STUDENT_LOGIN
  GUARDIAN_CONSENT
}

enum SessionPlatform {
  WEB
  ANDROID
  IOS
  ADMIN_WEB
}

enum ConsentStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

model User {
  id                  String              @id @default(uuid())
  email               String?             @unique
  mobile              String?             @unique
  fullName            String
  passwordHash        String?
  accountType         AccountType         @default(STUDENT)
  accountStatus       AccountStatus       @default(ACTIVE)
  preparationLanguage PreparationLanguage @default(kn)
  isLanguageLocked    Boolean             @default(false)
  isActive            Boolean             @default(true)
  emailVerifiedAt     DateTime?
  mobileVerifiedAt    DateTime?
  lastLoginAt         DateTime?
  failedLoginCount    Int                 @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  userRoles             UserRole[]
  studentProfile        StudentProfile?
  sessions              UserSession[]
  guardianConsents      GuardianConsent[]
  rankedAttempts        RankedAttempt[]
  rankedResults         RankedResult[]
  practiceSessions      PracticeSession[]
  mcqPracticeHistories  StudentMcqPracticeHistory[]
  taxonomyPracticeStats StudentTaxonomyPracticeStats[]
  performanceEvents     StudentPerformanceEvent[]
  taxonomyPerformances  StudentTaxonomyPerformance[]
  studyPlans            StudentStudyPlan[]

  @@map("users")
}

model StudentProfile {
  id                          String              @id @default(uuid())
  userId                      String              @unique
  dateOfBirth                 DateTime
  preparationLanguage         PreparationLanguage @default(kn)
  preparationLanguageLockedAt DateTime?
  profileCompletedAt          DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model OTPChallenge {
  id                String     @id @default(uuid())
  mobile            String
  purpose           OtpPurpose
  hashedCode        String
  expiresAt         DateTime
  maximumAttempts   Int        @default(3)
  attemptsUsed      Int        @default(0)
  resendAvailableAt DateTime
  consumedAt        DateTime?
  requestIp         String?
  userAgent         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([mobile, purpose])
  @@map("otp_challenges")
}

model UserSession {
  id               String          @id @default(uuid())
  userId           String?
  adminUserId      String?
  refreshTokenHash String
  deviceId         String?
  deviceName       String?
  platform         SessionPlatform @default(WEB)
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  lastUsedAt       DateTime        @default(now())
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([adminUserId])
  @@map("user_sessions")
}

model GuardianConsent {
  id                   String        @id @default(uuid())
  studentUserId        String
  guardianName         String
  guardianRelationship String
  guardianMobile       String
  consentStatus        ConsentStatus @default(PENDING)
  consentRequestedAt   DateTime      @default(now())
  consentVerifiedAt    DateTime?
  verificationMethod   String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  studentUser User @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
  @@map("guardian_consents")
}

model AdminUser {
  id                String        @id @default(uuid())
  email             String        @unique
  fullName          String
  passwordHash      String
  accountStatus     AccountStatus @default(ACTIVE)
  isActive          Boolean       @default(true)
  failedLoginCount  Int           @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  adminRoles AdminRole[]
  auditLogs  AdminAuditLog[]
  sessions   UserSession[]

  syllabiReviewed  ExamSyllabus[] @relation("SyllabusReviewedBy")
  syllabiApproved  ExamSyllabus[] @relation("SyllabusApprovedBy")
  syllabiPublished ExamSyllabus[] @relation("SyllabusPublishedBy")
  syllabiCreated   ExamSyllabus[] @relation("SyllabusCreatedBy")
  syllabiUpdated   ExamSyllabus[] @relation("SyllabusUpdatedBy")

  @@map("admin_users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  adminRoles      AdminRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AdminRole {
  adminUserId String
  roleId      String
  assignedAt  DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@map("admin_roles")
}

model AdminAuditLog {
  id            String   @id @default(uuid())
  adminUserId   String
  action        String
  module        String
  recordType    String?
  recordId      String?
  previousValue Json?
  newValue      Json?
  reason        String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("admin_audit_logs")
}

enum ExamCycleStatus {
  DRAFT
  REVIEW_PENDING
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ExamVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum ImportantDateType {
  NOTIFICATION
  APPLICATION_START
  APPLICATION_END
  FEE_PAYMENT_END
  CORRECTION_WINDOW
  ADMIT_CARD
  EXAM
  RESULT
  CUSTOM
}

enum OfficialResourceType {
  OFFICIAL_NOTIFICATION
  OFFICIAL_WEBSITE
  APPLICATION
  INSTRUCTIONS
  CALENDAR
  OTHER
}

model ExamAuthority {
  id                 String   @id @default(uuid())
  code               String   @unique
  nameEn             String
  nameKn             String
  shortNameEn        String?
  shortNameKn        String?
  descriptionEn      String?
  descriptionKn      String?
  officialWebsiteUrl String?
  logoUrl            String?
  isActive           Boolean  @default(true)
  createdByAdminId   String?
  updatedByAdminId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  programmes ExamProgramme[]

  @@map("exam_authorities")
}

model ExamProgramme {
  id                        String   @id @default(uuid())
  authorityId               String
  code                      String   @unique
  nameEn                    String
  nameKn                    String
  shortNameEn               String?
  shortNameKn               String?
  descriptionEn             String?
  descriptionKn             String?
  overviewEn                String?
  overviewKn                String?
  eligibilitySummaryEn      String?
  eligibilitySummaryKn      String?
  selectionProcessSummaryEn String?
  selectionProcessSummaryKn String?
  officialProgrammeUrl      String?
  isActive                  Boolean  @default(true)
  createdByAdminId          String?
  updatedByAdminId          String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  authority ExamAuthority @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  cycles    ExamCycle[]
  testSeries TestSeries[]

  @@map("exam_programmes")
}

model ExamCycle {
  id                      String          @id @default(uuid())
  programmeId             String
  cycleCode               String
  cycleYear               Int
  titleEn                 String
  titleKn                 String
  descriptionEn           String?
  descriptionKn           String?
  notificationNumber      String?
  notificationDate        DateTime?
  applicationStartDate    DateTime?
  applicationEndDate      DateTime?
  feePaymentEndDate       DateTime?
  tentativeExamDate       DateTime?
  resultDate              DateTime?
  officialNotificationUrl String?
  applicationUrl          String?
  logoUrl                 String?
  status                  ExamCycleStatus @default(DRAFT)
  visibility              ExamVisibility  @default(PRIVATE)
  reviewSubmittedAt       DateTime?
  reviewedAt              DateTime?
  reviewedByAdminId       String?
  publishedAt             DateTime?
  publishedByAdminId      String?
  closedAt                DateTime?
  archivedAt              DateTime?
  createdByAdminId        String?
  updatedByAdminId        String?
  version                 Int             @default(1)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  programme         ExamProgramme          @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  eligibility       ExamEligibility?
  importantDates    ExamImportantDate[]
  officialResources ExamOfficialResource[]
  seo               ExamSEO?
  patterns          ExamPattern[]
  syllabi           ExamSyllabus[]
  mcqQuestions      McqQuestion[]

  mockTests                 MockTest[]
  currentAffairs            CurrentAffairExam[]
  studyPlanTemplates        StudyPlanTemplate[]
  studyPlans                StudentStudyPlan[]

  @@unique([programmeId, cycleCode])
  @@index([status, visibility])
  @@index([cycleYear])
  @@index([programmeId, status])
  @@index([updatedAt])
  @@map("exam_cycles")
}

model ExamEligibility {
  id                       String    @id @default(uuid())
  examCycleId              String    @unique
  minimumAge               Int?
  maximumAge               Int?
  ageCalculatedOn          DateTime?
  minimumEducationEn       String?
  minimumEducationKn       String?
  nationalityRequirementEn String?
  nationalityRequirementKn String?
  domicileRequirementEn    String?
  domicileRequirementKn    String?
  attemptsSummaryEn        String?
  attemptsSummaryKn        String?
  additionalCriteriaEn     String?
  additionalCriteriaKn     String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  examCycle ExamCycle @relation(fields: [examCycleId], references: [id], onDelete: Cascade)

  @@map("exam_eligibility")
}

model ExamImportantDate {
  id           String            @id @default(uuid())
  examCycleId  String
  examStageId  String?
  type         ImportantDateType @default(CUSTOM)
  labelEn      String
  labelKn      String
  startAt      DateTime
  endAt        DateTime?
  isTentative  Boolean           @default(false)
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  examCycle ExamCycle  @relation(fields: [examCycleId], references: [id], onDelete: Cascade)
  examStage ExamStage? @relation(fields: [examStageId], references: [id], onDelete: SetNull)

  @@index([examCycleId, startAt])
  @@index([examStageId])
  @@map("exam_important_dates")
}

model ExamOfficialResource {
  id           String               @id @default(uuid())
  examCycleId  String
  resourceType OfficialResourceType @default(OTHER)
  labelEn      String
  labelKn      String
  url          String
  displayOrder Int                  @default(0)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  examCycle ExamCycle      @relation(fields: [examCycleId], references: [id], onDelete: Cascade)
  syllabi   ExamSyllabus[]

  @@map("exam_official_resources")
}

model ExamSEO {
  id                  String   @id @default(uuid())
  examCycleId         String   @unique
  slugEn              String   @unique
  slugKn              String   @unique
  metaTitleEn         String?
  metaTitleKn         String?
  metaDescriptionEn   String?
  metaDescriptionKn   String?
  socialTitleEn       String?
  socialTitleKn       String?
  socialDescriptionEn String?
  socialDescriptionKn String?
  canonicalUrlEn      String?
  canonicalUrlKn      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  examCycle ExamCycle @relation(fields: [examCycleId], references: [id], onDelete: Cascade)

  @@map("exam_seo")
}

// -----------------------------------------------------------------------------
// EXAM PATTERN & ACADEMIC STRUCTURE ENUMS & MODELS (PROMPT 4)
// -----------------------------------------------------------------------------

enum ExamPatternStatus {
  DRAFT
  REVIEW_PENDING
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ExamStageType {
  PRELIMINARY
  MAIN
  INTERVIEW
  PHYSICAL_TEST
  SKILL_TEST
  PRACTICAL_TEST
  DOCUMENT_VERIFICATION
  MEDICAL_TEST
  OTHER
}

enum ExamAssessmentMode {
  OBJECTIVE
  DESCRIPTIVE
  INTERVIEW
  PRACTICAL
  SKILL
  PHYSICAL
  DOCUMENT_VERIFICATION
  MEDICAL
  OTHER
}

enum ExamQuestionFormat {
  MCQ_SINGLE_CORRECT
  MCQ_MULTIPLE_CORRECT
  TRUE_FALSE
  MATCHING
  SHORT_ANSWER
  LONG_ANSWER
  ESSAY
  CASE_STUDY
  INTERVIEW
  PRACTICAL
  SKILL
  PHYSICAL
  OTHER
}

enum ExamMediumRule {
  BILINGUAL
  KANNADA
  ENGLISH
  CANDIDATE_CHOICE
  NOT_APPLICABLE
  CUSTOM
}

enum NegativeMarkingType {
  NONE
  FIXED_MARKS
  PERCENTAGE_OF_QUESTION_MARKS
  FRACTION_OF_QUESTION_MARKS
}

enum QualifyingRuleType {
  NONE
  MARKS
  PERCENTAGE
  AGGREGATE_MARKS
  AGGREGATE_PERCENTAGE
  ALL_QUALIFYING_PAPERS
  CUSTOM
}

model ExamPattern {
  id                    String            @id @default(uuid())
  examCycleId           String
  revisionNumber        Int
  sourcePatternId       String?
  titleEn               String
  titleKn               String
  descriptionEn         String?           @db.Text
  descriptionKn         String?           @db.Text
  generalInstructionsEn String?           @db.Text
  generalInstructionsKn String?           @db.Text
  sourceResourceId      String?
  sourceReference       String?
  status                ExamPatternStatus @default(DRAFT)
  isCurrent             Boolean           @default(false)
  reviewSubmittedAt     DateTime?
  reviewedAt            DateTime?
  reviewedByAdminId     String?
  approvedAt            DateTime?
  approvedByAdminId     String?
  publishedAt           DateTime?
  publishedByAdminId    String?
  archivedAt            DateTime?
  createdByAdminId      String?
  updatedByAdminId      String?
  version               Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  examCycle ExamCycle      @relation(fields: [examCycleId], references: [id], onDelete: Cascade)
  stages    ExamStage[]
  syllabi   ExamSyllabus[]

  @@unique([examCycleId, revisionNumber])
  @@index([examCycleId])
  @@index([examCycleId, status, isCurrent])
  @@index([updatedAt])
  @@map("exam_patterns")
}

model ExamStage {
  id                      String             @id @default(uuid())
  examPatternId           String
  code                    String
  stageType               ExamStageType
  nameEn                  String
  nameKn                  String
  shortNameEn             String?
  shortNameKn             String?
  descriptionEn           String?            @db.Text
  descriptionKn           String?            @db.Text
  instructionsEn          String?            @db.Text
  instructionsKn          String?            @db.Text
  displayOrder            Int
  isQualifying            Boolean            @default(false)
  contributesToFinalMerit Boolean            @default(true)
  qualificationRuleType   QualifyingRuleType @default(NONE)
  qualificationValue      Decimal?           @db.Decimal(10, 2)
  qualificationRuleEn     String?            @db.Text
  qualificationRuleKn     String?            @db.Text
  isActive                Boolean            @default(true)
  version                 Int                @default(1)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  examPattern               ExamPattern                @relation(fields: [examPatternId], references: [id], onDelete: Cascade)
  papers                    ExamPaper[]
  importantDates            ExamImportantDate[]
  syllabusNodes             ExamSyllabusNode[]
  mockTests                 MockTest[]
  testSeries                TestSeries[]
  currentAffairs            CurrentAffairStage[]
  studyPlans                StudentStudyPlan[]

  @@unique([examPatternId, code])
  @@unique([examPatternId, displayOrder])
  @@index([examPatternId])
  @@map("exam_stages")
}

model ExamPaper {
  id                                 String              @id @default(uuid())
  examStageId                        String
  code                               String
  assessmentMode                     ExamAssessmentMode
  nameEn                             String
  nameKn                             String
  shortNameEn                        String?
  shortNameKn                        String?
  descriptionEn                      String?             @db.Text
  descriptionKn                      String?             @db.Text
  instructionsEn                     String?             @db.Text
  instructionsKn                     String?             @db.Text
  mediumRule                         ExamMediumRule      @default(BILINGUAL)
  mediumInstructionsEn               String?             @db.Text
  mediumInstructionsKn               String?             @db.Text
  displayOrder                       Int
  durationMinutes                    Int?
  totalQuestions                     Int?
  questionsToAnswer                  Int?
  totalMarks                         Decimal?            @db.Decimal(10, 2)
  isQualifying                       Boolean             @default(false)
  contributesToStageMerit            Boolean             @default(true)
  qualifyingRuleType                 QualifyingRuleType  @default(NONE)
  qualifyingValue                    Decimal?            @db.Decimal(10, 2)
  defaultNegativeMarkingType         NegativeMarkingType @default(NONE)
  defaultNegativeMarkingValue        Decimal?            @db.Decimal(10, 2)
  defaultNegativeFractionNumerator   Int?
  defaultNegativeFractionDenominator Int?
  calculatorEnabled                  Boolean             @default(false)
  isActive                           Boolean             @default(true)
  version                            Int                 @default(1)
  createdAt                          DateTime            @default(now())
  updatedAt                          DateTime            @updatedAt

  examStage                 ExamStage                  @relation(fields: [examStageId], references: [id], onDelete: Cascade)
  sections                  ExamPaperSection[]
  syllabusNodes             ExamSyllabusNode[]
  mockTests                 MockTest[]
  testSeries                TestSeries[]

  @@unique([examStageId, code])
  @@unique([examStageId, displayOrder])
  @@index([examStageId])
  @@map("exam_papers")
}

model ExamPaperSection {
  id                          String               @id @default(uuid())
  examPaperId                 String
  code                        String
  questionFormat              ExamQuestionFormat
  nameEn                      String
  nameKn                      String
  descriptionEn               String?              @db.Text
  descriptionKn               String?              @db.Text
  instructionsEn              String?              @db.Text
  instructionsKn              String?              @db.Text
  displayOrder                Int
  totalQuestions              Int
  questionsToAnswer           Int
  marksPerQuestion            Decimal              @db.Decimal(10, 2)
  calculatedTotalMarks        Decimal              @db.Decimal(10, 2)
  durationMinutes             Int?
  negativeMarkingType         NegativeMarkingType?
  negativeMarkingValue        Decimal?             @db.Decimal(10, 2)
  negativeFractionNumerator   Int?
  negativeFractionDenominator Int?
  isQualifying                Boolean              @default(false)
  qualifyingRuleType          QualifyingRuleType   @default(NONE)
  qualifyingValue             Decimal?             @db.Decimal(10, 2)
  contributesToPaperMerit     Boolean              @default(true)
  isActive                    Boolean              @default(true)
  version                     Int                  @default(1)
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  examPaper ExamPaper @relation(fields: [examPaperId], references: [id], onDelete: Cascade)

  @@unique([examPaperId, code])
  @@unique([examPaperId, displayOrder])
  @@index([examPaperId])
  @@map("exam_paper_sections")
}

// -----------------------------------------------------------------------------
// PROMPT 5: EXAM SYLLABUS TREE & BILINGUAL SYLLABUS MANAGEMENT
// -----------------------------------------------------------------------------

enum ExamSyllabusStatus {
  DRAFT
  REVIEW_PENDING
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ExamSyllabusNodeType {
  SUBJECT
  SECTION
  UNIT
  TOPIC
  SUBTOPIC
  KNOWLEDGE_AREA
  THEME
  OTHER
}

enum ExamSyllabusScopeType {
  GLOBAL
  STAGE
  PAPER
}

model ExamSyllabus {
  id                    String             @id @default(uuid())
  examCycleId           String
  examPatternId         String
  revisionNumber        Int
  sourceSyllabusId      String?
  titleEn               String
  titleKn               String
  descriptionEn         String?            @db.Text
  descriptionKn         String?            @db.Text
  generalInstructionsEn String?            @db.Text
  generalInstructionsKn String?            @db.Text
  sourceResourceId      String?
  sourceReference       String?
  status                ExamSyllabusStatus @default(DRAFT)
  isCurrent             Boolean            @default(false)
  reviewSubmittedAt     DateTime?
  reviewedAt            DateTime?
  reviewedByAdminId     String?
  approvedAt            DateTime?
  approvedByAdminId     String?
  publishedAt           DateTime?
  publishedByAdminId    String?
  archivedAt            DateTime?
  createdByAdminId      String?
  updatedByAdminId      String?
  version               Int                @default(1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  examCycle        ExamCycle             @relation(fields: [examCycleId], references: [id], onDelete: Cascade)
  examPattern      ExamPattern           @relation(fields: [examPatternId], references: [id], onDelete: Cascade)
  sourceSyllabus   ExamSyllabus?         @relation("SyllabusCloningRelation", fields: [sourceSyllabusId], references: [id], onDelete: SetNull)
  derivedSyllabi   ExamSyllabus[]        @relation("SyllabusCloningRelation")
  sourceResource   ExamOfficialResource? @relation(fields: [sourceResourceId], references: [id], onDelete: SetNull)
  reviewedByAdmin  AdminUser?            @relation("SyllabusReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  approvedByAdmin  AdminUser?            @relation("SyllabusApprovedBy", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  publishedByAdmin AdminUser?            @relation("SyllabusPublishedBy", fields: [publishedByAdminId], references: [id], onDelete: SetNull)
  createdByAdmin   AdminUser?            @relation("SyllabusCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  updatedByAdmin   AdminUser?            @relation("SyllabusUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  nodes            ExamSyllabusNode[]

  @@unique([examCycleId, revisionNumber])
  @@index([examCycleId])
  @@index([examPatternId])
  @@index([examCycleId, status, isCurrent])
  @@index([updatedAt])
  @@map("exam_syllabi")
}

model ExamSyllabusNode {
  id              String                @id @default(uuid())
  examSyllabusId  String
  parentId        String?
  code            String
  nodeType        ExamSyllabusNodeType
  scopeType       ExamSyllabusScopeType @default(GLOBAL)
  examStageId     String?
  examPaperId     String?
  nameEn          String
  nameKn          String
  shortNameEn     String?
  shortNameKn     String?
  descriptionEn   String?               @db.Text
  descriptionKn   String?               @db.Text
  officialTextEn  String?               @db.Text
  officialTextKn  String?               @db.Text
  sourceReference String?
  displayOrder    Int
  depth           Int                   @default(1)
  isActive        Boolean               @default(true)
  version         Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  examSyllabus ExamSyllabus       @relation(fields: [examSyllabusId], references: [id], onDelete: Cascade)
  parent       ExamSyllabusNode?  @relation("SyllabusNodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     ExamSyllabusNode[] @relation("SyllabusNodeHierarchy")
  examStage    ExamStage?         @relation(fields: [examStageId], references: [id], onDelete: SetNull)
  examPaper    ExamPaper?         @relation(fields: [examPaperId], references: [id], onDelete: SetNull)
  mcqQuestions McqQuestion[]
  planningMetadata StudyTopicPlanningMetadata?

  @@unique([examSyllabusId, code])
