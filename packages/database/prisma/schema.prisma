  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt

  student     User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examCycle   ExamCycle          @relation(fields: [examCycleId], references: [id], onDelete: Cascade)
  examStage   ExamStage?         @relation(fields: [examStageId], references: [id], onDelete: SetNull)
  template    StudyPlanTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  plannerRule StudyPlannerRule   @relation(fields: [plannerRuleId], references: [id], onDelete: Restrict)

  days        StudyPlanDay[]
  tasks       StudyPlanTask[]
  histories   StudyPlanHistory[]

  @@index([studentId])
  @@index([examCycleId])
  @@index([status])
  @@map("student_study_plans")
}

// Scaffold for Phase 2
model StudyPlanDay {
  id               String           @id @default(uuid())
  studyPlanId      String
  date             DateTime
  dayNumber        Int
  weekNumber       Int
  status           StudyPlanTaskStatus @default(DRAFT)
  plannedMinutes   Int              @default(0)
  availableMinutesOverride Int?
  completedMinutes Int              @default(0)
  backlogMinutes   Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  studyPlan StudentStudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  tasks     StudyPlanTask[]

  @@index([studyPlanId])
  @@index([date])
  @@map("study_plan_days")
}

enum StudyPlanTaskType {
  CONCEPT
  REVISION
  MCQ
  CURRENT_AFFAIRS
  RECOVERY
  TEST
  BUFFER
  OTHER
}

model StudyPlanTask {
  id               String            @id @default(uuid())
  studyPlanDayId   String
  studyPlanId      String
  taskType         StudyPlanTaskType
  plannedMinutes   Int
  completedMinutes Int               @default(0)
  status           StudyPlanTaskStatus @default(DRAFT)
  
  // Relations/References
  topicId          String?
  parentSubjectId  String?
  studyMaterialId  String?
  mcqTestId        String?
  
  sessionNumber    Int?              @default(1)
  totalSessions    Int?              @default(1)
  
  originalConceptTaskId String?    // For revisions to point back
  
  isRecovery       Boolean           @default(false)
  actualCompletionDate DateTime?
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  studyPlanDay StudyPlanDay     @relation(fields: [studyPlanDayId], references: [id], onDelete: Cascade)
  studyPlan    StudentStudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  // Weak references for Phase 2 flexibility
  // topic AcademicTopic? @relation(fields: [topicId], references: [id])
  // studyMaterial StudyMaterial? @relation(fields: [studyMaterialId], references: [id])

  @@index([studyPlanDayId])
  @@index([studyPlanId])
  @@map("study_plan_tasks")
}

model StudyPlanHistory {
  id           String           @id @default(uuid())
  studyPlanId  String
  action       String
  description  String?
  snapshot     Json?
  createdAt    DateTime         @default(now())

  studyPlan StudentStudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@index([studyPlanId])
  @@map("study_plan_histories")
}
