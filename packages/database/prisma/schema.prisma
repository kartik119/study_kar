// ==========================================
// PROMPT 07: STUDY MATERIAL FOUNDATION MODELS
// ==========================================

enum StudyMaterialContentType {
  ARTICLE
  STUDY_NOTE
  LESSON
  CHAPTER
  GUIDE
  REFERENCE
}

enum StudyMaterialRecordStatus {
  ACTIVE
  ARCHIVED
}

enum StudyMaterialLocaleStatus {
  DRAFT
}

enum StudyMaterialLocaleRevisionStatus {
  DRAFT
  REVIEW_PENDING
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum StudyMaterialReviewAction {
  SUBMITTED
  COMMENTED
  CHANGES_REQUESTED
  RESUBMITTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

model StudyMaterial {
  id                String                    @id @default(uuid())
  code              String                    @unique
  logoUrl           String?                   @db.Text
  contentType       StudyMaterialContentType  @default(ARTICLE)
  recordStatus      StudyMaterialRecordStatus @default(ACTIVE)
  createdByAdminId  String?
  updatedByAdminId  String?
  archivedAt        DateTime?
  archivedByAdminId String?
  version           Int                       @default(1)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  locales          StudyMaterialLocale[]
  taxonomyMappings StudyMaterialTaxonomyMapping[]
  accessPolicy     StudyMaterialAccessPolicy?

  @@index([code])
  @@index([contentType, recordStatus])
  @@index([updatedAt])
  @@map("study_materials")
}

enum StudyMaterialAccessType {
  FREE
  PAID
  FREEMIUM
}

enum StudyMaterialPreviewMode {
  FULL
  SUMMARY_ONLY
  CONTENT_BOUNDARY
}

model StudyMaterialAccessPolicy {
  id                           String                  @id @default(uuid())
  studyMaterialId              String                  @unique
  accessType                   StudyMaterialAccessType @default(FREE)
  entitlementKey               String                  @unique
  teaserMode                   String                  @default("SUMMARY_ONLY")
  freeMcqSampleCount           Int                     @default(0)
  freeQuickRevisionSampleCount Int                     @default(0)
  isActive                     Boolean                 @default(true)
  version                      Int                     @default(1)
  createdByAdminId             String?
  updatedByAdminId             String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  studyMaterial  StudyMaterial                      @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  previewConfigs StudyMaterialLocalePreviewConfig[]

  @@index([studyMaterialId])
  @@index([accessType])
  @@index([entitlementKey])
  @@map("study_material_access_policies")
}

model StudyMaterialLocalePreviewConfig {
  id                  String                   @id @default(uuid())
  accessPolicyId      String
  localeRevisionId    String
  language            String
  previewMode         StudyMaterialPreviewMode @default(FULL)
  previewEndNodeId    String?
  previewEndInclusive Boolean                  @default(true)
  paywallTitle        String?
  paywallMessage      String?                  @db.Text
  version             Int                      @default(1)
  createdByAdminId    String?
  updatedByAdminId    String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  accessPolicy   StudyMaterialAccessPolicy   @relation(fields: [accessPolicyId], references: [id], onDelete: Cascade)
  localeRevision StudyMaterialLocaleRevision @relation(fields: [localeRevisionId], references: [id], onDelete: Cascade)

  @@unique([accessPolicyId, localeRevisionId])
  @@index([accessPolicyId])
  @@index([localeRevisionId])
  @@map("study_material_locale_preview_configs")
}

model StudyMaterialLocale {
  id               String                    @id @default(uuid())
  studyMaterialId  String
  language         String
  title            String
  shortTitle       String?
  slug             String
  summary          String?                   @db.Text
  contentJson      Json?
  plainTextContent String?                   @db.Text
  localeStatus     StudyMaterialLocaleStatus @default(DRAFT)
  createdByAdminId String?
  updatedByAdminId String?
  version          Int                       @default(1)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  studyMaterial StudyMaterial                 @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  revisions     StudyMaterialLocaleRevision[]

  @@unique([studyMaterialId, language])
  @@unique([language, slug])
  @@index([language, slug])
  @@index([studyMaterialId, language])
  @@map("study_material_locales")
}

model StudyMaterialLocaleRevision {
  id                    String  @id @default(uuid())
  studyMaterialLocaleId String
  revisionNumber        Int     @default(1)
  sourceRevisionId      String?

  // Content
  title            String
  shortTitle       String?
  slug             String
  summary          String? @db.Text
  contentJson      Json?
  plainTextContent String? @db.Text

  // SEO
  metaTitle         String?
  metaDescription   String? @db.Text
  socialTitle       String?
  socialDescription String? @db.Text
  canonicalUrl      String?
  robotsIndex       Boolean @default(true)
  robotsFollow      Boolean @default(true)

  // Workflow & Audit Timestamps
  status             StudyMaterialLocaleRevisionStatus @default(DRAFT)
  reviewSubmittedAt  DateTime?
  reviewedAt         DateTime?
  reviewedByAdminId  String?
  approvedAt         DateTime?
  approvedByAdminId  String?
  publishedAt        DateTime?
  publishedByAdminId String?
  archivedAt         DateTime?

  // Flags & Operational
  isCurrentDraft     Boolean  @default(true)
  isCurrentPublished Boolean  @default(false)
  createdByAdminId   String?
  updatedByAdminId   String?
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  studyMaterialLocale StudyMaterialLocale                @relation(fields: [studyMaterialLocaleId], references: [id], onDelete: Cascade)
  sourceRevision      StudyMaterialLocaleRevision?       @relation("RevisionHistory", fields: [sourceRevisionId], references: [id], onDelete: SetNull)
  derivedRevisions    StudyMaterialLocaleRevision[]      @relation("RevisionHistory")
  reviewEvents        StudyMaterialReviewEvent[]
  previewConfigs      StudyMaterialLocalePreviewConfig[]

  @@unique([studyMaterialLocaleId, revisionNumber])
  @@index([studyMaterialLocaleId, status])
  @@index([status])
  @@index([studyMaterialLocaleId, isCurrentDraft], map: "sm_locale_rev_draft_idx")
  @@index([studyMaterialLocaleId, isCurrentPublished], map: "sm_locale_rev_pub_idx")
  @@map("study_material_locale_revisions")
}

model StudyMaterialReviewEvent {
  id               String                    @id @default(uuid())
  localeRevisionId String
  action           StudyMaterialReviewAction
  comment          String?                   @db.Text
  adminUserId      String
  createdAt        DateTime                  @default(now())

  localeRevision StudyMaterialLocaleRevision @relation(fields: [localeRevisionId], references: [id], onDelete: Cascade)

  @@index([localeRevisionId])
  @@index([adminUserId])
  @@index([createdAt])
  @@map("study_material_review_events")
}

model StudyMaterialTaxonomyMapping {
  id               String   @id @default(uuid())
  studyMaterialId  String
  categoryId       String
  subcategoryId    String
  topicId          String
  knowledgeAreaId  String?
  isPrimary        Boolean  @default(false)
  createdByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studyMaterial StudyMaterial          @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  category      AcademicCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory   AcademicSubcategory    @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  topic         AcademicTopic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  knowledgeArea AcademicKnowledgeArea? @relation(fields: [knowledgeAreaId], references: [id], onDelete: SetNull)

  @@unique([studyMaterialId, categoryId, subcategoryId, topicId, knowledgeAreaId])
  @@index([studyMaterialId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([topicId])
  @@index([knowledgeAreaId])
  @@index([studyMaterialId, isPrimary])
  @@map("study_material_taxonomy_mappings")
}

// ==========================================
// MCQ Question Bank & Mock Test Series Domain
// ==========================================

enum McqDifficulty {
  EASY
  MEDIUM
  HARD
}

enum McqWorkflowStatus {
  DRAFT
  REVIEW_PENDING
  CHANGES_REQUESTED
  APPROVED
  ARCHIVED
}

enum McqSourceType {
  ORIGINAL
  PREVIOUS_YEAR_QUESTION
  OFFICIAL_SOURCE
  REFERENCE
}

model McqSequenceCounter {
  id        String   @id @default("mcq_counter")
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("mcq_sequence_counters")
}

model McqQuestion {
  id             String            @id @default(uuid())
  code           String            @unique // e.g. MCQ_000001
  seqNumber      Int?              @unique
  questionTextEn String            @db.Text
  questionTextKn String            @db.Text
  optionA_En     String            @db.Text
  optionA_Kn     String            @db.Text
  optionB_En     String            @db.Text
  optionB_Kn     String            @db.Text
  optionC_En     String            @db.Text
  optionC_Kn     String            @db.Text
  optionD_En     String            @db.Text
  optionD_Kn     String            @db.Text
  correctOption  String // 'A' | 'B' | 'C' | 'D'
  explanationEn  String?           @db.Text
  explanationKn  String?           @db.Text
  difficulty     McqDifficulty     @default(MEDIUM)
  positiveMarks  Decimal           @default(1.00) @db.Decimal(5, 2)
  negativeMarks  Decimal           @default(0.25) @db.Decimal(5, 2)
  status         McqWorkflowStatus @default(DRAFT)

  // Academic Taxonomy Mapping
  categoryId      String?
  subcategoryId   String?
  topicId         String?
  knowledgeAreaId String?

  // Optional Exam & Syllabus Mapping
  examCycleId    String?
  syllabusNodeId String?

  // Source & PYQ Information
  sourceType        McqSourceType? @default(ORIGINAL)
  sourceName        String?
  sourceUrl         String?
  isPyq             Boolean        @default(false)
  pyqExamName       String?
  pyqYear           Int?
  pyqPaperStage     String?
  pyqQuestionNumber String?
  pyqNotes          String?        @db.Text

  // Duplicate Stem Indexes
  normalizedStemEn String? @db.Text
  normalizedStemKn String? @db.Text

  isActive          Boolean  @default(true)
  createdByAdminId  String?
  reviewedByAdminId String?
  approvedByAdminId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  examCycle     ExamCycle?             @relation(fields: [examCycleId], references: [id], onDelete: SetNull)
  syllabusNode  ExamSyllabusNode?      @relation(fields: [syllabusNodeId], references: [id], onDelete: SetNull)
  category      AcademicCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory   AcademicSubcategory?   @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  topic         AcademicTopic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  knowledgeArea AcademicKnowledgeArea? @relation(fields: [knowledgeAreaId], references: [id], onDelete: SetNull)

  mockTestQuestions        MockTestQuestion[]
  practiceSessionQuestions PracticeSessionQuestion[]
  practiceHistories        StudentMcqPracticeHistory[]
  performanceEvents        StudentPerformanceEvent[]
  currentAffairId          String?
  currentAffair            CurrentAffair?              @relation(fields: [currentAffairId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([examCycleId])
  @@index([syllabusNodeId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([topicId])
  @@index([knowledgeAreaId])
  @@index([difficulty])
  @@index([status])
  @@index([isPyq])
  @@index([isActive])
  @@map("mcq_questions")
}

enum TestWorkflowStatus {
  DRAFT
  REVIEW_PENDING
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum TestSelectionMode {
  MANUAL
  AUTOMATIC
}

enum TestScoringPolicy {
  TEST_DEFAULT
  MCQ_DEFAULT
}

enum TestAccessClassification {
  FREE
  PAID
  FREEMIUM
}

enum PyqPreference {
  ANY
  EXCLUDE_PYQ
  PYQ_ONLY
}

model TestSequenceCounter {
  id        String   @id @default("singleton")
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("test_sequence_counters")
}

model MockTest {
  id                   String                   @id @default(uuid())
  code                 String                   @unique
  seqNumber            Int?                     @unique
  titleEn              String
  titleKn              String
  descriptionEn        String?                  @db.Text
  descriptionKn        String?                  @db.Text
  instructionsEn       String?                  @db.Text
  instructionsKn       String?                  @db.Text
  examCycleId          String?
  examStageId          String?
  examPaperId          String?
  totalQuestions       Int                      @default(0)
  durationMinutes      Int                      @default(60)
  totalMarks           Decimal                  @default(0.00) @db.Decimal(8, 2)
  passingPercentage    Decimal                  @default(40.00) @db.Decimal(5, 2)
  accessClassification TestAccessClassification @default(FREE)
  scoringPolicy        TestScoringPolicy        @default(TEST_DEFAULT)
  positiveMarks        Decimal                  @default(1.00) @db.Decimal(5, 2)
  negativeMarks        Decimal                  @default(0.25) @db.Decimal(5, 2)
  selectionMode        TestSelectionMode        @default(MANUAL)
  pyqPreference        PyqPreference            @default(ANY)
  generationSeed       String?
  status               TestWorkflowStatus       @default(DRAFT)
  isPublished          Boolean                  @default(false)
  createdByAdminId     String?
  submittedByAdminId   String?
  reviewedByAdminId    String?
  approvedByAdminId    String?
  publishedByAdminId   String?
  rejectionReason      String?                  @db.Text
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  examCycle ExamCycle? @relation(fields: [examCycleId], references: [id], onDelete: SetNull)
  examStage ExamStage? @relation(fields: [examStageId], references: [id], onDelete: SetNull)
  examPaper ExamPaper? @relation(fields: [examPaperId], references: [id], onDelete: SetNull)

  questions                MockTestQuestion[]
  categoryDistributions    TestCategoryDistribution[]
  subcategoryDistributions TestSubcategoryDistribution[]
  difficultyDistributions  TestDifficultyDistribution[]
  testSeriesEntries        TestSeriesTest[]
  rankedConfigs            RankedTest[]

  @@index([code])
  @@index([examCycleId])
  @@index([examStageId])
  @@index([examPaperId])
  @@index([status])
  @@index([isPublished])
  @@map("mock_tests")
}

model TestCategoryDistribution {
  id          String   @id @default(uuid())
  mockTestId  String
  categoryId  String
  targetCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mockTest MockTest         @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  category AcademicCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([mockTestId, categoryId])
  @@index([mockTestId])
  @@map("test_category_distributions")
}

model TestSubcategoryDistribution {
  id            String   @id @default(uuid())
  mockTestId    String
  subcategoryId String
  targetCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mockTest    MockTest            @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  subcategory AcademicSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([mockTestId, subcategoryId])
  @@index([mockTestId])
  @@map("test_subcategory_distributions")
}

model TestDifficultyDistribution {
  id          String        @id @default(uuid())
  mockTestId  String
  difficulty  McqDifficulty
  targetCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  mockTest MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)

  @@unique([mockTestId, difficulty])
  @@index([mockTestId])
  @@map("test_difficulty_distributions")
}

model MockTestQuestion {
  id                    String         @id @default(uuid())
  mockTestId            String
  questionId            String
  displayOrder          Int            @default(1)
  sectionTitleEn        String?
  sectionTitleKn        String?
  selectionSource       String         @default("MANUAL") // 'MANUAL' | 'AUTOMATIC'
  selectedCategoryId    String?
  selectedSubcategoryId String?
  selectedDifficulty    McqDifficulty?
  positiveMarks         Decimal        @default(1.00) @db.Decimal(5, 2)
  negativeMarks         Decimal        @default(0.25) @db.Decimal(5, 2)

  // Immutable Publication Snapshots
  snapshotQuestionEn    String?        @db.Text
  snapshotQuestionKn    String?        @db.Text
  snapshotOptionA_En    String?        @db.Text
  snapshotOptionA_Kn    String?        @db.Text
  snapshotOptionB_En    String?        @db.Text
  snapshotOptionB_Kn    String?        @db.Text
  snapshotOptionC_En    String?        @db.Text
  snapshotOptionC_Kn    String?        @db.Text
  snapshotOptionD_En    String?        @db.Text
  snapshotOptionD_Kn    String?        @db.Text
  snapshotCorrectOption String?
  snapshotExplanationEn String?        @db.Text
  snapshotExplanationKn String?        @db.Text
  snapshotDifficulty    McqDifficulty?
  snapshotPositiveMarks Decimal?       @db.Decimal(5, 2)
  snapshotNegativeMarks Decimal?       @db.Decimal(5, 2)
  createdAt             DateTime       @default(now())

  mockTest MockTest    @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  question McqQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  attemptAnswers RankedAttemptAnswer[]

  @@unique([mockTestId, questionId])
  @@unique([mockTestId, displayOrder])
  @@index([mockTestId])
  @@index([questionId])
  @@map("mock_test_questions")
}

enum McqImportMode {
