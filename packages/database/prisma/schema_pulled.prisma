generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin_audit_logs {
  id            String      @id
  adminUserId   String
  action        String
  module        String
  recordType    String?
  recordId      String?
  previousValue Json?
  newValue      Json?
  reason        String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())
  admin_users   admin_users @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
}

model admin_roles {
  adminUserId String
  roleId      String
  assignedAt  DateTime    @default(now())
  admin_users admin_users @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  roles       roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
}

model admin_users {
  id                                                        String             @id
  email                                                     String             @unique
  fullName                                                  String
  passwordHash                                              String
  accountStatus                                             AccountStatus      @default(ACTIVE)
  isActive                                                  Boolean            @default(true)
  failedLoginCount                                          Int                @default(0)
  lockedUntil                                               DateTime?
  lastLoginAt                                               DateTime?
  passwordChangedAt                                         DateTime?
  createdAt                                                 DateTime           @default(now())
  updatedAt                                                 DateTime
  admin_audit_logs                                          admin_audit_logs[]
  admin_roles                                               admin_roles[]
  exam_syllabi_exam_syllabi_approvedByAdminIdToadmin_users  exam_syllabi[]     @relation("exam_syllabi_approvedByAdminIdToadmin_users")
  exam_syllabi_exam_syllabi_createdByAdminIdToadmin_users   exam_syllabi[]     @relation("exam_syllabi_createdByAdminIdToadmin_users")
  exam_syllabi_exam_syllabi_publishedByAdminIdToadmin_users exam_syllabi[]     @relation("exam_syllabi_publishedByAdminIdToadmin_users")
  exam_syllabi_exam_syllabi_reviewedByAdminIdToadmin_users  exam_syllabi[]     @relation("exam_syllabi_reviewedByAdminIdToadmin_users")
  exam_syllabi_exam_syllabi_updatedByAdminIdToadmin_users   exam_syllabi[]     @relation("exam_syllabi_updatedByAdminIdToadmin_users")
  user_sessions                                             user_sessions[]
}

model current_affair_academic_categories {
  currentAffairId           String
  categoryId                String
  study_material_categories study_material_categories @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  current_affairs           current_affairs           @relation(fields: [currentAffairId], references: [id], onDelete: Cascade)

  @@id([currentAffairId, categoryId])
}

model current_affair_academic_topics {
  currentAffairId       String
  topicId               String
  current_affairs       current_affairs       @relation(fields: [currentAffairId], references: [id], onDelete: Cascade)
  study_material_topics study_material_topics @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([currentAffairId, topicId])
}

model current_affair_exams {
  currentAffairId String
  examCycleId     String
  current_affairs current_affairs @relation(fields: [currentAffairId], references: [id], onDelete: Cascade)
  exam_cycles     exam_cycles     @relation(fields: [examCycleId], references: [id], onDelete: Cascade)

  @@id([currentAffairId, examCycleId])
}

model current_affair_pdfs {
  id               String              @id
  titleEn          String
  titleKn          String
  type             PdfType
  periodStart      DateTime?
  periodEnd        DateTime?
  language         PdfLanguage
  fileUrl          String
  fileId           String?
  status           CurrentAffairStatus @default(DRAFT)
  publishedAt      DateTime?
  descriptionEn    String?
  descriptionKn    String?
  createdByAdminId String
  updatedByAdminId String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime
}

model current_affair_stages {
  currentAffairId String
  examStageId     String
  current_affairs current_affairs @relation(fields: [currentAffairId], references: [id], onDelete: Cascade)
  exam_stages     exam_stages     @relation(fields: [examStageId], references: [id], onDelete: Cascade)

  @@id([currentAffairId, examStageId])
}

model current_affair_tags_map {
  currentAffairId      String
  tagId                String
  current_affairs      current_affairs      @relation(fields: [currentAffairId], references: [id], onDelete: Cascade)
  current_affairs_tags current_affairs_tags @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([currentAffairId, tagId])
}

model current_affair_trending_topics {
  id           String   @id
  topicEn      String
  topicKn      String
  slug         String   @unique
  description  String?
  priority     Int      @default(0)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model current_affairs {
  id                                 String                               @id
  slug                               String                               @unique
  titleEn                            String
  titleKn                            String
  summaryEn                          String
  summaryKn                          String
  contentEn                          String
  contentKn                          String
  categoryId                         String
  sourceId                           String
  publishedAt                        DateTime?
  readingTimeMinutes                 Int?
  featuredImageUrl                   String?
  featuredImageFileId                String?
  imageAltEn                         String?
  imageAltKn                         String?
  imageCaptionEn                     String?
  imageCaptionKn                     String?
  status                             CurrentAffairStatus                  @default(DRAFT)
  visibility                         CurrentAffairVisibility              @default(PUBLIC)
  importance                         CurrentAffairImportance              @default(MEDIUM)
  isFeatured                         Boolean                              @default(false)
  allowComments                      Boolean                              @default(true)
  metaTitleEn                        String?
  metaTitleKn                        String?
  metaDescriptionEn                  String?
  metaDescriptionKn                  String?
  canonicalUrl                       String?
  socialImage                        String?
  robotsSetting                      String?
  createdByAdminId                   String?
  updatedByAdminId                   String?
  createdAt                          DateTime                             @default(now())
  updatedAt                          DateTime
  deletedAt                          DateTime?
  current_affair_academic_categories current_affair_academic_categories[]
  current_affair_academic_topics     current_affair_academic_topics[]
  current_affair_exams               current_affair_exams[]
  current_affair_stages              current_affair_stages[]
  current_affair_tags_map            current_affair_tags_map[]
  current_affairs_categories         current_affairs_categories           @relation(fields: [categoryId], references: [id])
  current_affairs_sources            current_affairs_sources              @relation(fields: [sourceId], references: [id])
  mcq_questions                      mcq_questions[]

  @@index([categoryId])
  @@index([createdAt])
  @@index([publishedAt])
  @@index([sourceId])
  @@index([status])
}

model current_affairs_categories {
  id              String            @id
  slug            String            @unique
  nameEn          String
  nameKn          String
  descriptionEn   String?
  descriptionKn   String?
  icon            String?
  displayOrder    Int               @default(0)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  current_affairs current_affairs[]
}

model current_affairs_sources {
  id              String            @id
  name            String            @unique
  logoUrl         String?
  websiteUrl      String?
  description     String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  current_affairs current_affairs[]
}

model current_affairs_tags {
  id                      String                    @id
  slug                    String                    @unique
  name                    String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  current_affair_tags_map current_affair_tags_map[]
}

model exam_authorities {
  id                 String            @id
  code               String            @unique
  nameEn             String
  nameKn             String
  shortNameEn        String?
  shortNameKn        String?
  descriptionEn      String?
  descriptionKn      String?
  officialWebsiteUrl String?
  logoUrl            String?
  isActive           Boolean           @default(true)
  createdByAdminId   String?
  updatedByAdminId   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime
  exam_programmes    exam_programmes[]
}

model exam_cycles {
  id                      String                    @id
  programmeId             String
  cycleCode               String
  cycleYear               Int
  titleEn                 String
  titleKn                 String
  descriptionEn           String?
  descriptionKn           String?
  notificationNumber      String?
  notificationDate        DateTime?
  applicationStartDate    DateTime?
  applicationEndDate      DateTime?
  feePaymentEndDate       DateTime?
  tentativeExamDate       DateTime?
  resultDate              DateTime?
  officialNotificationUrl String?
  applicationUrl          String?
  status                  ExamCycleStatus           @default(DRAFT)
  visibility              ExamVisibility            @default(PRIVATE)
  reviewSubmittedAt       DateTime?
  reviewedAt              DateTime?
  reviewedByAdminId       String?
  publishedAt             DateTime?
  publishedByAdminId      String?
  closedAt                DateTime?
  archivedAt              DateTime?
  createdByAdminId        String?
  updatedByAdminId        String?
  version                 Int                       @default(1)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  logoUrl                 String?
  current_affair_exams    current_affair_exams[]
  exam_programmes         exam_programmes           @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  exam_eligibility        exam_eligibility?
  exam_important_dates    exam_important_dates[]
  exam_official_resources exam_official_resources[]
  exam_patterns           exam_patterns[]
  exam_seo                exam_seo?
  exam_syllabi            exam_syllabi[]
  mcq_questions           mcq_questions[]
  mock_tests              mock_tests[]
  products                products[]
  student_study_plans     student_study_plans[]
  study_plan_templates    study_plan_templates[]
  subscription_modules    subscription_modules[]

  @@unique([programmeId, cycleCode])
  @@index([cycleYear])
  @@index([programmeId, status])
  @@index([status, visibility])
  @@index([updatedAt])
}

model exam_eligibility {
  id                       String      @id
  examCycleId              String      @unique
  minimumAge               Int?
  maximumAge               Int?
  ageCalculatedOn          DateTime?
  minimumEducationEn       String?
  minimumEducationKn       String?
  nationalityRequirementEn String?
  nationalityRequirementKn String?
  domicileRequirementEn    String?
  domicileRequirementKn    String?
  attemptsSummaryEn        String?
  attemptsSummaryKn        String?
  additionalCriteriaEn     String?
  additionalCriteriaKn     String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime
  exam_cycles              exam_cycles @relation(fields: [examCycleId], references: [id], onDelete: Cascade)
}

model exam_important_dates {
  id           String            @id
  examCycleId  String
  type         ImportantDateType @default(CUSTOM)
  labelEn      String
  labelKn      String
  startAt      DateTime
  endAt        DateTime?
  isTentative  Boolean           @default(false)
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime
  examStageId  String?
  exam_cycles  exam_cycles       @relation(fields: [examCycleId], references: [id], onDelete: Cascade)
  exam_stages  exam_stages?      @relation(fields: [examStageId], references: [id])

  @@index([examCycleId, startAt])
  @@index([examStageId])
}

model exam_official_resources {
  id           String               @id
  examCycleId  String
  resourceType OfficialResourceType @default(OTHER)
  labelEn      String
  labelKn      String
  url          String
  displayOrder Int                  @default(0)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime
  exam_cycles  exam_cycles          @relation(fields: [examCycleId], references: [id], onDelete: Cascade)
  exam_syllabi exam_syllabi[]
}

model exam_paper_sections {
  id                          String               @id
  examPaperId                 String
  code                        String
  questionFormat              ExamQuestionFormat
  nameEn                      String
  nameKn                      String
  descriptionEn               String?
  descriptionKn               String?
  instructionsEn              String?
  instructionsKn              String?
  displayOrder                Int
  totalQuestions              Int
  questionsToAnswer           Int
  marksPerQuestion            Decimal              @db.Decimal(10, 2)
  calculatedTotalMarks        Decimal              @db.Decimal(10, 2)
  durationMinutes             Int?
  negativeMarkingType         NegativeMarkingType?
  negativeMarkingValue        Decimal?             @db.Decimal(10, 2)
  negativeFractionNumerator   Int?
  negativeFractionDenominator Int?
  isQualifying                Boolean              @default(false)
  qualifyingRuleType          QualifyingRuleType   @default(NONE)
  qualifyingValue             Decimal?             @db.Decimal(10, 2)
  contributesToPaperMerit     Boolean              @default(true)
  isActive                    Boolean              @default(true)
  version                     Int                  @default(1)
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime
  exam_papers                 exam_papers          @relation(fields: [examPaperId], references: [id], onDelete: Cascade)

  @@unique([examPaperId, code])
  @@unique([examPaperId, displayOrder])
  @@index([examPaperId])
}

model exam_papers {
  id                                 String                @id
  examStageId                        String
  code                               String
  assessmentMode                     ExamAssessmentMode
  nameEn                             String
  nameKn                             String
  shortNameEn                        String?
  shortNameKn                        String?
  descriptionEn                      String?
  descriptionKn                      String?
  instructionsEn                     String?
  instructionsKn                     String?
  mediumRule                         ExamMediumRule        @default(BILINGUAL)
  mediumInstructionsEn               String?
  mediumInstructionsKn               String?
  displayOrder                       Int
  durationMinutes                    Int?
  totalQuestions                     Int?
  questionsToAnswer                  Int?
  totalMarks                         Decimal?              @db.Decimal(10, 2)
  isQualifying                       Boolean               @default(false)
  contributesToStageMerit            Boolean               @default(true)
  qualifyingRuleType                 QualifyingRuleType    @default(NONE)
  qualifyingValue                    Decimal?              @db.Decimal(10, 2)
  defaultNegativeMarkingType         NegativeMarkingType   @default(NONE)
  defaultNegativeMarkingValue        Decimal?              @db.Decimal(10, 2)
  defaultNegativeFractionNumerator   Int?
  defaultNegativeFractionDenominator Int?
  calculatorEnabled                  Boolean               @default(false)
  isActive                           Boolean               @default(true)
  version                            Int                   @default(1)
  createdAt                          DateTime              @default(now())
  updatedAt                          DateTime
  examCode                           String?
  exam_paper_sections                exam_paper_sections[]
  exam_stages                        exam_stages           @relation(fields: [examStageId], references: [id], onDelete: Cascade)
  exam_syllabus_nodes                exam_syllabus_nodes[]
  mock_tests                         mock_tests[]
  test_series                        test_series[]

  @@unique([examStageId, code])
  @@unique([examStageId, displayOrder])
  @@index([examStageId])
}

model exam_patterns {
  id                    String            @id
  examCycleId           String
  revisionNumber        Int
  sourcePatternId       String?
  titleEn               String
  titleKn               String
  descriptionEn         String?
  descriptionKn         String?
  generalInstructionsEn String?
  generalInstructionsKn String?
  sourceResourceId      String?
  sourceReference       String?
  status                ExamPatternStatus @default(DRAFT)
  isCurrent             Boolean           @default(false)
  reviewSubmittedAt     DateTime?
  reviewedAt            DateTime?
  reviewedByAdminId     String?
  approvedAt            DateTime?
  approvedByAdminId     String?
  publishedAt           DateTime?
  publishedByAdminId    String?
  archivedAt            DateTime?
  createdByAdminId      String?
  updatedByAdminId      String?
  version               Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime
  totalStages           Int               @default(0)
  exam_cycles           exam_cycles       @relation(fields: [examCycleId], references: [id], onDelete: Cascade)
  exam_stages           exam_stages[]
  exam_syllabi          exam_syllabi[]

  @@unique([examCycleId, revisionNumber])
  @@index([examCycleId])
  @@index([examCycleId, status, isCurrent])
  @@index([updatedAt])
}

model exam_programmes {
  id                        String           @id
  authorityId               String
  code                      String           @unique
  nameEn                    String
  nameKn                    String
  shortNameEn               String?
  shortNameKn               String?
  descriptionEn             String?
  descriptionKn             String?
  overviewEn                String?
  overviewKn                String?
  eligibilitySummaryEn      String?
  eligibilitySummaryKn      String?
  selectionProcessSummaryEn String?
  selectionProcessSummaryKn String?
  officialProgrammeUrl      String?
  isActive                  Boolean          @default(true)
  createdByAdminId          String?
  updatedByAdminId          String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime
  exam_cycles               exam_cycles[]
  exam_authorities          exam_authorities @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  test_series               test_series[]
}

model exam_seo {
  id                  String      @id
  examCycleId         String      @unique
  slugEn              String      @unique
  slugKn              String      @unique
  metaTitleEn         String?
  metaTitleKn         String?
  metaDescriptionEn   String?
  metaDescriptionKn   String?
  socialTitleEn       String?
  socialTitleKn       String?
  socialDescriptionEn String?
  socialDescriptionKn String?
  canonicalUrlEn      String?
  canonicalUrlKn      String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime
  exam_cycles         exam_cycles @relation(fields: [examCycleId], references: [id], onDelete: Cascade)
}

model exam_stages {
  id                      String                  @id
  examPatternId           String
  code                    String
  stageType               ExamStageType
  nameEn                  String
  nameKn                  String
  shortNameEn             String?
  shortNameKn             String?
  descriptionEn           String?
  descriptionKn           String?
  instructionsEn          String?
  instructionsKn          String?
  displayOrder            Int
  isQualifying            Boolean                 @default(false)
  contributesToFinalMerit Boolean                 @default(true)
  qualificationRuleType   QualifyingRuleType      @default(NONE)
  qualificationValue      Decimal?                @db.Decimal(10, 2)
  qualificationRuleEn     String?
  qualificationRuleKn     String?
  isActive                Boolean                 @default(true)
  version                 Int                     @default(1)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime
  examCode                String?
  current_affair_stages   current_affair_stages[]
  exam_important_dates    exam_important_dates[]
  exam_papers             exam_papers[]
  exam_patterns           exam_patterns           @relation(fields: [examPatternId], references: [id], onDelete: Cascade)
  exam_syllabus_nodes     exam_syllabus_nodes[]
  mock_tests              mock_tests[]
  student_study_plans     student_study_plans[]
  test_series             test_series[]

  @@unique([examPatternId, code])
  @@unique([examPatternId, displayOrder])
  @@index([examPatternId])
}

model exam_syllabi {
  id                                                       String                   @id
  examCycleId                                              String
  examPatternId                                            String
  revisionNumber                                           Int
  sourceSyllabusId                                         String?
  titleEn                                                  String
  titleKn                                                  String
  descriptionEn                                            String?
  descriptionKn                                            String?
  generalInstructionsEn                                    String?
  generalInstructionsKn                                    String?
  sourceResourceId                                         String?
  sourceReference                                          String?
  status                                                   ExamSyllabusStatus       @default(DRAFT)
  isCurrent                                                Boolean                  @default(false)
  reviewSubmittedAt                                        DateTime?
  reviewedAt                                               DateTime?
  reviewedByAdminId                                        String?
  approvedAt                                               DateTime?
  approvedByAdminId                                        String?
  publishedAt                                              DateTime?
  publishedByAdminId                                       String?
  archivedAt                                               DateTime?
  createdByAdminId                                         String?
  updatedByAdminId                                         String?
  version                                                  Int                      @default(1)
  createdAt                                                DateTime                 @default(now())
  updatedAt                                                DateTime
  admin_users_exam_syllabi_approvedByAdminIdToadmin_users  admin_users?             @relation("exam_syllabi_approvedByAdminIdToadmin_users", fields: [approvedByAdminId], references: [id])
  admin_users_exam_syllabi_createdByAdminIdToadmin_users   admin_users?             @relation("exam_syllabi_createdByAdminIdToadmin_users", fields: [createdByAdminId], references: [id])
  exam_cycles                                              exam_cycles              @relation(fields: [examCycleId], references: [id], onDelete: Cascade)
  exam_patterns                                            exam_patterns            @relation(fields: [examPatternId], references: [id], onDelete: Cascade)
  admin_users_exam_syllabi_publishedByAdminIdToadmin_users admin_users?             @relation("exam_syllabi_publishedByAdminIdToadmin_users", fields: [publishedByAdminId], references: [id])
  admin_users_exam_syllabi_reviewedByAdminIdToadmin_users  admin_users?             @relation("exam_syllabi_reviewedByAdminIdToadmin_users", fields: [reviewedByAdminId], references: [id])
  exam_official_resources                                  exam_official_resources? @relation(fields: [sourceResourceId], references: [id])
  exam_syllabi                                             exam_syllabi?            @relation("exam_syllabiToexam_syllabi", fields: [sourceSyllabusId], references: [id])
  other_exam_syllabi                                       exam_syllabi[]           @relation("exam_syllabiToexam_syllabi")
  admin_users_exam_syllabi_updatedByAdminIdToadmin_users   admin_users?             @relation("exam_syllabi_updatedByAdminIdToadmin_users", fields: [updatedByAdminId], references: [id])
  exam_syllabus_nodes                                      exam_syllabus_nodes[]

  @@unique([examCycleId, revisionNumber])
  @@index([examCycleId])
  @@index([examCycleId, status, isCurrent])
  @@index([examPatternId])
  @@index([updatedAt])
}

model exam_syllabus_nodes {
  id                            String                         @id
  examSyllabusId                String
  parentId                      String?
  code                          String
  nodeType                      ExamSyllabusNodeType
  scopeType                     ExamSyllabusScopeType          @default(GLOBAL)
  examStageId                   String?
  examPaperId                   String?
  nameEn                        String
  nameKn                        String
  shortNameEn                   String?
  shortNameKn                   String?
  descriptionEn                 String?
  descriptionKn                 String?
  officialTextEn                String?
  officialTextKn                String?
  sourceReference               String?
  displayOrder                  Int
  depth                         Int                            @default(1)
  isActive                      Boolean                        @default(true)
  version                       Int                            @default(1)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime
  examCode                      String?
  exam_papers                   exam_papers?                   @relation(fields: [examPaperId], references: [id])
  exam_stages                   exam_stages?                   @relation(fields: [examStageId], references: [id])
  exam_syllabi                  exam_syllabi                   @relation(fields: [examSyllabusId], references: [id], onDelete: Cascade)
  exam_syllabus_nodes           exam_syllabus_nodes?           @relation("exam_syllabus_nodesToexam_syllabus_nodes", fields: [parentId], references: [id], onDelete: Cascade)
  other_exam_syllabus_nodes     exam_syllabus_nodes[]          @relation("exam_syllabus_nodesToexam_syllabus_nodes")
  mcq_questions                 mcq_questions[]
  study_topic_planning_metadata study_topic_planning_metadata?

  @@unique([examSyllabusId, code])
  @@index([examPaperId])
  @@index([examStageId])
  @@index([examSyllabusId])
  @@index([examSyllabusId, isActive])
  @@index([examSyllabusId, nodeType])
  @@index([parentId])
}

model guardian_consents {
  id                   String        @id
  studentUserId        String
  guardianName         String
  guardianRelationship String
  guardianMobile       String
  consentStatus        ConsentStatus @default(PENDING)
  consentRequestedAt   DateTime      @default(now())
  consentVerifiedAt    DateTime?
  verificationMethod   String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime
  users                users         @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
}

model mcq_bulk_import_sessions {
  id               String          @id
  originalFileName String
  fileType         String
  importMode       McqImportMode   @default(ADD_NEW)
  totalRows        Int             @default(0)
  validRows        Int             @default(0)
  errorRows        Int             @default(0)
  warningRows      Int             @default(0)
  importedRows     Int             @default(0)
  status           McqImportStatus @default(VALIDATED)
  startedByAdminId String?
  failureReason    String?
  reportSummary    Json?
  createdAt        DateTime        @default(now())
  completedAt      DateTime?

  @@index([createdAt])
  @@index([status])
}

model mcq_categories {
  id                     String                   @id
  code                   String                   @unique
  nameEn                 String
  nameKn                 String
  descriptionEn          String?
  descriptionKn          String?
  iconUrl                String?
  displayOrder           Int                      @default(0)
  isActive               Boolean                  @default(true)
  createdByAdminId       String?
  updatedByAdminId       String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  mcq_questions          mcq_questions[]
  mcq_subcategories      mcq_subcategories[]
  mcq_topics             mcq_topics[]
