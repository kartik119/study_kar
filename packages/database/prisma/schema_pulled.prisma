model StudyMaterialExamMapping {
  id               String   @id @default(uuid())
  studyMaterialId  String
  examCycleId      String
  createdByAdminId String?
  createdAt        DateTime @default(now())

  studyMaterial StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  examCycle     ExamCycle     @relation(fields: [examCycleId], references: [id], onDelete: Cascade)

  @@unique([studyMaterialId, examCycleId])
  @@index([studyMaterialId])
  @@index([examCycleId])
}
